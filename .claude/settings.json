{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -x scripts/dockit-bootstrap-context.sh ]; then scripts/dockit-bootstrap-context.sh --json; fi'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh -c 'if [ -x scripts/dockit-session-gate.sh ]; then scripts/dockit-session-gate.sh --start; fi'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -x scripts/dockit-session-gate.sh ]; then scripts/dockit-session-gate.sh --stop; fi'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if ! scripts/dockit-validate-session.sh --json --quiet --check handoff-date --check history-entry >/dev/null 2>&1; then printf \"{\\\"additionalContext\\\":\\\"Reminder: docs/llm/HANDOFF.md and/or docs/llm/HISTORY.md need updating for today.\\\"}\"; fi'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"IMPORTANT: Before this session ends, update docs/llm/HANDOFF.md (Last Updated date + status) and add an entry to docs/llm/HISTORY.md. Run scripts/dockit-validate-session.sh --human to check.\"}'"
          }
        ]
      }
    ]
  }
}
